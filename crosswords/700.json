  "definitions": {
    "down": {
      "1": "\u05e1\u05dc\u05e3 \u05d5\u05dc\u05d0 \u05de\u05e7\u05d9\u05d9\u05dd \u05db\u05de\u05d5 \u05d1\u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd, \u05d6\u05d4 \u05de\u05d4 \u05e9\u05e2\u05d5\u05d1\u05e8\u05d9\u05dd \u05d1\u05e0\u05d3\u05d5\u05d3\u05d9\u05dd \u05e7\u05e9\u05d9\u05dd (5, 6)",
      "2": "\u05d4\u05d1\u05d9\u05d0 \u05e6\u05d9\u05d5\u05d3 \u05d5\u05d4\u05e6\u05dc\u05d7\u05ea\u05d9 \u05dc\u05d4\u05db\u05e0\u05e1 \u05d1\u05d3\u05d5\u05d3, \u05d9\u05e9 \u05e9\u05dd \u05e8\u05d5\u05e4\u05d0\u05d9\u05dd (4, 4, 5)",
      "3": "\u05d4\u05e6\u05d9\u05d2\u05d5 \u05e9\u05de\u05d5\u05e0\u05d4 \u05e9\u05d0\u05e4\u05e9\u05e8 \u05dc\u05de\u05d3\u05d5\u05d3 \u05d1\u05de\u05e6\u05d1 \u05e9\u05dc \u05e9\u05d9\u05e0\u05d4 \u05e7\u05dc\u05d4 (2, 3) (\u05de)",
      "4": "\u05de\u05d9\u05d3 \u05d9\u05d4\u05d9\u05d5 \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd, \u05d2\u05d1\u05e8\u05ea \u05d5\u05de\u05e0\u05d9\u05df (3, 4)(\u05d7)",
      "5": "\u05d9\u05de\u05d9 \u05e9\u05e9\u05d9 \u05e2\u05dd \u05d0\u05d5\u05dc\u05d9 \u05de\u05e6\u05e8\u05d9 \u05e9\u05d1\u05e4\u05e8\u05d9 (4, 5)",
      "6": "\u05d1\u05e2\u05dc\u05ea \u05ea\u05e4\u05e7\u05d9\u05d3 \u05e9\u05dc\u05d0 \u05e7\u05d5\u05e4\u05e6\u05ea \u05dc\u05d7\u05d5\u05e4\u05d4 \u05e1\u05ea\u05dd (5, 7)",
      "7": "\u05e8\u05d0\u05d5 \u05d0\u05ea \u05d0\u05dc\u05d5 \u05e9\u05d1\u05d0\u05ea\u05d9 \u05d1\u05d4\u05dd \u05d1\u05e1\u05d5\u05e3 \u05de\u05d6\u05de\u05df, \u05d4\u05d5\u05d0 \u05de\u05e9\u05d5\u05e8\u05e8 (4, 6)",
      "8": "\u05dc\u05d0 \u05d2\u05d5\u05d1\u05d4 \u05e1\u05db\u05d5\u05dd \u05de\u05d3\u05d5\u05d9\u05e7 \u05db\u05d9 \u05d6\u05d4 \u05de\u05d0\u05d1\u05e7 \u05de\u05ea\u05de\u05e9\u05da (4, 4)",
      "9": "\u05de\u05d4 \u05e9\u05db\u05dc \u05d7\u05d1\u05e8\u05d4 \u05e8\u05d5\u05e6\u05d4 \u05d6\u05d4 \u05d6\u05d0\u05d1\u05d9\u05dd (6)(\u05de)",
      "10": "\u05e8\u05d0\u05d4/\u05d9 39 \u05de\u05d0\u05d5\u05d6\u05df",
      "17": "\u05e6\u05e8\u05ea\u05dd \u05d5\u05dc\u05d0 \u05e2\u05e9\u05d9\u05ea\u05dd \u05db\u05dc\u05d5\u05dd (5)",
      "19": "\u05e2\u05d9\u05e8 \u05d1\u05e2\u05d6\u05e8\u05ea \u05e1\u05d9\u05e4\u05d5\u05e8, \u05d5\u05ea\u05e8\u05d5 \u05e2\u05dc \u05d9\u05d3\u05d9\u05ea \u05d1\u05d6\u05de\u05e0\u05d9\u05dd \u05d1\u05d4\u05dd \u05dc\u05d0 \u05de\u05e1\u05db\u05d9\u05de\u05d9\u05dd (5, 2, 6)",
      "21": "\u05dc\u05d7\u05dd \u05d5\u05de\u05e9\u05e7\u05d4 \u05de\u05d5\u05db\u05e0\u05d9\u05dd \u05dc\u05d4\u05d2\u05e9\u05d4 \u05dc\u05e4\u05d9 \u05d4\u05e9\u05d9\u05e8 (3, 3, 6)",
      "23": "\u05d4\u05de\u05d6\u05dc \u05e9\u05dc\u05d5 \u05de\u05e1\u05e4\u05d9\u05e7 \u05d1\u05e7\u05d1\u05d5\u05e6\u05ea \u05d3\u05d9\u05d5\u05df (5)",
      "24": "\u05d0\u05d5\u05dc\u05d9 \u05d4\u05db\u05d7\u05d5\u05dc \u05db\u05d4\u05d4 \u05d1\u05e1\u05d5\u05e3, \u05e7\u05d1\u05dc\u05ea \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d5\u05d9\u05e9 \u05e0\u05d4\u05d9\u05e8\u05d4 \u05dc\u05e7\u05dc\u05e4\u05d9\u05d5\u05ea (5, 6)",
      "26": "\u05de\u05e9\u05d7\u05e7 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9 \u05d0\u05d7\u05ea \u05e9\u05ea\u05d9\u05dd \u05de\u05d0\u05d9\u05e8 \u05e9\u05d1\u05d3\u05e7 \u05d8\u05d1\u05dc\u05d4 (4, 2, 4)",
      "28": "\u05de\u05e2\u05de\u05d9\u05d3 \u05e8\u05db\u05d1 \u05db\u05da \u05e9\u05d9\u05d4\u05d9\u05d4 \u05e7\u05dc \u05dc\u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05d5\u05ea\u05d5, \u05d4\u05e0\u05d5\u05d7 (4, 5)",
      "29": "\u05d1\u05df \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d0\u05d9\u05e0\u05e0\u05d5 \u05d5\u05d9\u05e9 \u05db\u05de\u05d4 \u05db\u05de\u05d5\u05d4\u05d5 \u05e9\u05de\u05d0\u05d1\u05d3\u05d9\u05dd \u05d1\u05d8\u05d7\u05d5\u05df (8)",
      "30": "\u05d4\u05d9\u05d4 \u05dc\u05d9 \u05d5\u05d9\u05db\u05d5\u05d7, \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05de\u05e1\u05e4\u05d9\u05e7\u05d4 \u05d1\u05e9\u05d1\u05d9\u05dc\u05d9, \u05d1\u05e1\u05d5\u05e3 \u05d4\u05d1\u05e0\u05ea\u05d9 (8) (\u05de)",
      "32": "\u05dc\u05e1\u05d2\u05df \u05d4\u05e0\u05e9\u05d9\u05d0 \u05d5\u05d0-\u05dc\u05d4\u05d9\u05dd \u05d9\u05e9 \u05de\u05d5\u05e1\u05e8 \u05d4\u05e9\u05db\u05dc (7)",
      "34": "\u05de\u05d0\u05d7\u05d3 \u05de\u05d4\u05d1\u05e0\u05d9\u05dd \u05d5\u05de\u05d4 \u05e9\u05e2\u05dc \u05d1\u05d9\u05ea \u05de\u05d0\u05d3 \u05e0\u05d4\u05e0\u05d4 (6)",
      "37": "\u05de\u05e0\u05d4 \u05e9\u05d1\u05e2\u05d9\u05dd \u05d1\u05e1\u05d3\u05e8\u05d4 (5)"
    },
    "across": {
      "1": "\u05db\u05dc\u05d9 \u05e6\u05d1\u05d0\u05d9 \u05e9\u05d0\u05d5\u05e1\u05e3 \u05de\u05d9\u05d3\u05e2 \u05de\u05d4\u05d0\u05d5\u05d5\u05d9\u05e8, \u05de\u05e2\u05d5\u05e3 \u05d5\u05de\u05d7\u05e8\u05d2\u05d5\u05dc \u05e9\u05d0\u05d9\u05df \u05dc\u05d5 \u05e8\u05d0\u05e9 (4, 4) (\u05d7)",
      "5": "\u05d0\u05d7\u05e8\u05d9 \u05e2\u05d5\u05d6\u05e8, \u05e0\u05ea\u05e0\u05d5 \u05ea\u05e4\u05e7\u05d9\u05d3 \u05dc\u05e7\u05e6\u05d9\u05df \u05d1\u05db\u05d9\u05e8 \u05d5\u05e9\u05de\u05d7\u05d5, \u05d5\u05d0\u05d9 \u05d0\u05e4\u05e9\u05e8 \u05dc\u05e8\u05d0\u05d5\u05ea \u05d0\u05d5\u05ea\u05d5 (6, 5)",
      "11": "\u05e9\u05d5\u05d1 \u05d0\u05ea \u05de\u05d9 \u05d9\u05d2\u05d0\u05dc\u05d5? \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d9\u05d5\u05ea \u05e9\u05d4\u05dd (6)",
      "12": "\u05e0\u05d5\u05d6\u05dc, \u05e1\u05d9\u05de\u05df \u05d5\u05d1\u05d3\u05d7\u05df \u05d1\u05ea\u05d5\u05da \u05d1\u05dc\u05d5\u05d9 \u05e9\u05dc\u05d5\u05e2\u05d2\u05d9\u05dd \u05dc\u05d5 (4, 4, 5)",
      "13": "\u05d4\u05dc\u05db\u05d5 \u05dc\u05d0\u05d9\u05d1\u05d5\u05d3 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc \u05e2\u05d5\u05e4\u05e8\u05d4 \u05d5\u05d6\u05d5 \u05de\u05d7\u05dc\u05d4 (5, 3)",
      "14": "\u05d7\u05d9\u05d1\u05d5\u05d8\u05d9 \u05e0\u05e4\u05e9 \u05d1\u05e4\u05e8\u05d9 (5)",
      "15": "\u05e0\u05d5\u05ea\u05df \u05de\u05e2\u05e6\u05de\u05d5 \u05d4\u05e8\u05d1\u05d4 \u05d0\u05d1\u05dc \u05de\u05ea\u05e8\u05d7\u05e7 \u05de\u05e9\u05dc\u05dd (5)",
      "16": "\u05d1\u05e2\u05d3 \u05d9\u05ea\u05e8\u05d5\u05df \u05d5\u05d4\u05e1\u05db\u05de\u05d4 \u05d1\u05d9\u05d7\u05e1\u05d9\u05dd (10)",
      "18": "\u05d0\u05d9\u05d6\u05d4 \u05e1\u05e4\u05d5\u05e8\u05d8\u05d0\u05d9 \u05e2\u05d9\u05dc\u05d9\u05ea \u05d1\u05e9\u05d9\u05e8? (2, 5)",
      "20": "\u05d1\u05dc\u05d9 \u05dc\u05d4\u05e9\u05e7\u05d9\u05e2 \u05e9\u05d5\u05dd \u05de\u05d0\u05de\u05e5, \u05d9\u05e9 \u05d4\u05e4\u05e8\u05d3\u05d4 \u05d1\u05d9\u05df \u05d0\u05d9\u05ea\u05df \u05dc\u05ea\u05e4\u05e8 \u05dc\u05d0 \u05d1\u05e2\u05d9\u05d9\u05ea\u05d9 (7, 5)",
      "22": "\u05d9\u05de\u05e1\u05d5\u05e8 \u05e4\u05d4 \u05e4\u05d4 \u05dc\u05d4' \u05d5\u05d9\u05ea\u05e7\u05d5\u05e3 \u05d0\u05d5\u05ea\u05d4 (5, 4)",
      "25": "\u05ea\u05d1\u05d7\u05e8 \u05d1\u05e9\u05d1\u05d9\u05dc\u05d9 \u05de\u05d9 \u05d9\u05d4\u05d9\u05d4 \u05d4\u05d2\u05d5\u05d0\u05dc, \u05d9\u05e9 \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd \u05d3\u05d9\u05d0\u05dc\u05d5\u05d2 (6, 3)",
      "27": "\u05dc\u05d4\u05d9\u05d5\u05ea \u05e8\u05d2\u05d9\u05e9 \u05e0\u05d0\u05d3 \u05d5\u05dc\u05d0 \u05dc\u05d4\u05e9\u05d0\u05d9\u05e8 \u05d7\u05d5\u05de\u05e9 \u05dc\u05de\u05e8\u05db\u05d6 (4, 5, 3)",
      "29": "\u05e0\u05d1\u05d9\u05d0\u05d4? \u05e9\u05dc\u05d5\u05dd, \u05d4\u05d9\u05d0 \u05de\u05e2\u05d5\u05d3\u05d3\u05ea \u05d0\u05d5\u05ea\u05d5 (5, 2)",
      "31": "\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d4\u05dd \u05d1\u05d7\u05d5\u05e9\u05da, \u05d4\u05d5\u05d0 \u05de\u05d0\u05d9\u05e8 \u05dc\u05d0\u05d9 \u05de\u05d9\u05dc\u05d4 (5, 5)",
      "33": "\u05d0\u05dd \u05e1\u05d5\u05e4\u05e8\u05d9\u05dd \u05d2\u05dd \u05d0\u05d5\u05ea\u05d5 \u05d4\u05dd \u05d7\u05de\u05d9\u05e9\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05de\u05d3\u05e4\u05d9\u05e1\u05d9\u05dd (5) (\u05de)",
      "35": "\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e9\u05d5\u05d8 \u05d1\u05db\u05e8\u05d9\u05da \u05e9\u05e2\u05e9\u05d5\u05d9 \u05de\u05ea\u05d5\u05d5\u05d9\u05dd (5)(\u05de)",
