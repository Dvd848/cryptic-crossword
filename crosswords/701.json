  "definitions": {
    "down": {
      "1": "\u05e0\u05d9\u05d7\u05d5\u05e9 \u05e9\u05d6\u05d4 \u05e2\u05d5\u05dc\u05d4 \u05d2\u05dd \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05ea\u05d5\u05ea\u05d7\u05d9\u05dd (5)",
      "2": "\u05d4\u05d9\u05db\u05df \u05de\u05d5\u05e1\u05ea\u05e8 \u05e1\u05d5\u05d2 \u05e9\u05dc \u05d1\u05e7\u05e8 (3)",
      "3": "\u05e8\u05d0\u05d4/\u05d9 8 \u05de\u05d0\u05d5\u05d6\u05df",
      "4": "\u05d4\u05d1\u05d7\u05d5\u05e8\u05d4 \u05d1\u05d4\u05de\u05d4, \u05d5\u05d2\u05dd \u05e8\u05e7 \u05e2\u05dd \u05d7\u05e6\u05d9 \u05de\u05d5\u05d7 (7)",
      "5": "\u05e9\u05d9\u05d3\u05dc\u05d5 \u05d0\u05ea \u05d6\u05d4 \u05e9\u05e1\u05d5\u05d7\u05d1 \u05dc\u05d7\u05d6\u05d5\u05e8 \u05d1\u05e9\u05d1\u05d9\u05dc \u05dc\u05e9\u05d9\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05d8\u05d5\u05d1 (5, 3)",
      "6": "\u05d0\u05d7\u05d3 \u05e9\u05e8\u05d0\u05d4 \u05d1\u05d7\u05d5\u05e5 \u05d0\u05d5\u05db\u05dc \u05d8\u05e2\u05d9\u05dd (4)",
      "7": "\u05d7\u05d9\u05d5\u05ea \u05e2\u05dd \u05e9\u05e2\u05e8 \u05d1\u05d9\u05df \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd (8)",
      "11": "\u05dc\u05da \u05ea\u05e0\u05e6\u05d9\u05d7 \u05d0\u05ea \u05d4\u05e0\u05d9\u05e6\u05d7\u05d5\u05df \u05d1\u05d3\u05e8\u05da \u05dc\u05de\u05e2\u05dc\u05d4, \u05d4\u05d9\u05d0 \u05de\u05d0\u05d5\u05d3 \u05d7\u05db\u05de\u05d4 (5, 2)",
      "13": "\u05e0\u05d8\u05d5 \u05dc\u05e8\u05d9\u05d1 \u05d1\u05d1\u05d9\u05ea \u05d4\u05de\u05e9\u05e4\u05d8 (7)",
      "15": "\u05d0\u05d9\u05df \u05d2\u05d5\u05e8\u05dc\u05d9 \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05e0\u05d4\u05d9\u05d2 \u05de\u05e4\u05dc\u05d2\u05d4 (4, 4)",
      "16": "\u05d8\u05e7\u05e1\u05d9\u05dd \u05d7\u05d9\u05d9\u05dd \u05ea\u05d5\u05da \u05de\u05d9\u05dc\u05d5\u05d9 \u05e4\u05e7\u05d5\u05d3\u05d5\u05ea (8)",
      "17": "\u05de\u05d1\u05e6\u05e2 \u05d1\u05e7\u05e6\u05d1 \u05dc\u05d0 \u05e1\u05d3\u05d9\u05e8 \u05d5\u05dc\u05d0 \u05d8\u05e2\u05d9\u05dd (7)",
      "19": "\u05e0\u05d7\u05e1\u05dc \u05d8\u05d5\u05e0\u05d4 \u05db\u05ea\u05d5\u05e1\u05e4\u05ea \u05e7\u05d8\u05e0\u05d4 (5)",
      "20": "\u05e0\u05d7\u05e1\u05dc \u05d0\u05ea \u05d4\u05d8\u05d5\u05e8\u05e3 \u05e9\u05d7\u05d3\u05e8 \u05dc\u05e9\u05d3\u05d4 (5)",
      "22": "\u05d4\u05d9\u05db\u05df \u05e0\u05d9\u05ea\u05df \u05dc\u05de\u05e6\u05d5\u05d0 \u05de\u05e1\u05e4\u05d9\u05e7 \u05d1\u05e9\u05d1\u05d9\u05dc \u05dc\u05d7\u05d6\u05d5\u05e8 \u05d5\u05dc\u05d0 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d7\u05d5\u05dc\u05d4? (4)",
      "24": "\u05d4\u05e9\u05e8 \u05e2\u05d5\u05dc\u05d4 \u05d5\u05d4\u05e9\u05e8\u05d4 \u05d9\u05d5\u05e8\u05d3\u05ea (3)"
    },
    "across": {
      "1": "\u05de\u05d9 \u05e9\u05d4\u05d5\u05e6\u05d9\u05d0 \u05e6\u05dc\u05d9\u05dc \u05de\u05d4\u05e4\u05d4 \u05d7\u05d5\u05d8\u05e3 \u05e9\u05d5\u05d1 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea (6, 5)",
      "8": "\u05e2\u05dd 3 \u05de\u05d0\u05d5\u05e0\u05da. \u05d4\u05e1\u05ea\u05dc\u05e7 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05de\u05e0\u05d4\u05dc \u05d7\u05d5\u05d6\u05e8, \u05d4\u05d5\u05d0 \u05e9\u05de\u05e8 \u05e2\u05dc \u05e8\u05d0\u05e9\u05d5\u05ea \u05d4\u05de\u05e4\u05dc\u05d2\u05d4  (4, 5)",
      "9": "\u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d9\u05e8\u05d0\u05d5 \u05d1\u05e1\u05d5\u05e3, \u05d1\u05ea\u05e0\u05d0\u05d9 \u05e9\u05d9\u05e9 \u05d1\u05e2\u05d9\u05d5\u05ea (9)",
      "10": "\u05d0\u05ea \u05dc\u05d5\u05d9\u05df \u05d9\u05e4\u05d2\u05e9\u05d5 \u05d1\u05e7\u05e0\u05d3\u05d4 (6)",
      "12": "\u05d2\u05d9\u05d1\u05d5\u05e8 \u05d6\u05e7\u05df \u05d2\u05d1\u05d5\u05d4 \u05e0\u05de\u05e6\u05d0 \u05d1\u05d7\u05d5\u05e5 (5)",
      "14": "\u05e1\u05d2\u05e0\u05d5\u05df \u05e9\u05dc \u05e4\u05dc\u05d9\u05d8\u05ea \u05e4\u05d4 \u05dc\u05d0 \u05e7\u05dc (3, 3)",
      "15": "\u05d6\u05d4 \u05de\u05d4 \u05d0\u05e0\u05d9 \u05e0\u05d5\u05ea\u05df \u05d1\u05d7\u05d6\u05e8\u05d4, \u05e9\u05d4\u05d5\u05d0 \u05d9\u05d2\u05d9\u05d3 \u05dc\u05da \u05de\u05d4 \u05dc\u05e2\u05e9\u05d5\u05ea (4, 3)",
      "17": "\u05ea\u05d5\u05e6\u05d9\u05d0\u05d9 \u05d6\u05d5\u05d2 \u05de\u05ea\u05d5\u05da \u05d0\u05dc\u05d5 \u05e9\u05d4\u05d9\u05d5 \u05e4\u05e2\u05dd \u05d1\u05d0\u05e8\u05e5 (7) (\u05de)",
      "18": "\u05e8\u05d0\u05d5\u05d9\u05d9\u05dd \u05dc\u05e9\u05dc\u05d8\u05d5\u05df \u05d1\u05d9\u05df \u05d4\u05de\u05dc\u05d7\u05de\u05d5\u05ea (6) (\u05de)",
      "19": "\u05e9\u05e8\u05d4 \u05d1\u05d0\u05d5\u05ea \u05dc\u05de\u05d3 (5)",
      "21": "\u05d9\u05d7\u05de\u05de\u05d5 \u05d0\u05ea \u05d4\u05d0\u05d5\u05d5\u05d9\u05e8\u05d4 \u05d1\u05e4\u05d0\u05e8\u05e7 \u05d1\u05e8\u05de\u05ea \u05d4\u05d2\u05d5\u05dc\u05df (6)",
      "23": "\u05de\u05d5\u05d1\u05d9\u05dc \u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea \u05dc\u05e8\u05d4\"\u05de \u05db\u05ea\u05d1 \u05e9\u05d9\u05e8\u05d9\u05dd (4, 3, 2) (\u05e2\"\u05e4 \u05d3\u05d5\u05d3 \u05d6\u05d4\u05d1\u05d9)",
      "25": "\u05e9\u05e8\u05d4 \u05e4\u05e2\u05dd \u05dc\u05d9\u05dc\u05d3 \u05e9\u05dc\u05d9 \u05de\u05e7\u05d3\u05d9\u05de\u05d4 (4)",
