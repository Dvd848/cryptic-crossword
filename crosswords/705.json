  "definitions": {
    "down": {
      "1": "\u05d6\u05d5 \u05e6\u05d9\u05e4\u05d5\u05e8 \u05d7\u05d5\u05e4\u05e9 \u05d1\u05e2\u05e6\u05dd (5)",
      "2": "\u05d1\u05d0\u05d9\u05d6\u05d4 \u05de\u05e7\u05e6\u05d5\u05e2 \u05e0\u05e9\u05de\u05e2 \u05e9\u05d4\u05d5\u05d0 \u05d4\u05d2\u05d9\u05e2 \u05dc\u05e2\u05d1\u05d5\u05d3 \u05d1\u05de\u05d8\u05d1\u05d7? (3)",
      "3": "\u05de\u05d4 \u05e9\u05e6\u05e4\u05e8\u05d3\u05e2 \u05de\u05ea\u05d1\u05e7\u05e9\u05ea \u05dc\u05e2\u05e9\u05d5\u05ea \u05e9\u05d5\u05d1 \u05d6\u05d4 \u05d1\u05e6\u05d1\u05e2 \u05e9\u05dc\u05d4 (5)",
      "4": "\u05d4\u05de\u05e7\u05d5\u05dd \u05d1\u05d5 \u05e0\u05e1\u05e4\u05e8\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e9\u05d0\u05d5\u05dc\u05d9 \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05d3\u05d9\u05d0\u05d8\u05d4 (7)",
      "5": "\u05e9\u05d9\u05d7\u05e7 \u05e4\u05e2\u05dd \u05e8\u05d5\u05e6\u05d7 \u05ea\u05e7\u05d9\u05e3 (4, 4)",
      "6": "\u05d4\u05e2\u05dc\u05de\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d6\u05d4 \u05e9\u05d7\u05d9\u05de\u05dd \u05de\u05e9\u05d4\u05d5 (4)",
      "7": "\u05d4\u05e0\u05d9\u05d9\u05d3\u05ea \u05e9\u05dc\u05d9 \u05e0\u05db\u05e0\u05e1\u05d4 \u05d1\u05d9\u05df \u05d4\u05e8\u05d4\u05d9\u05d8\u05d9\u05dd \u05d1\u05dc\u05d9 \u05dc\u05d7\u05e9\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d3\u05d9 (8)",
      "11": "\u05d6\u05d4 \u05dc\u05d0 \u05e6\u05d5\u05de\u05d7, \u05dc\u05d0 \u05d1\u05d2\u05e1\u05d5\u05ea, \u05d5\u05d0\u05e8\u05d5\u05da... (3, 4)",
      "13": "\u05ea\u05d5\u05e9\u05d1 \u05d4\u05de\u05d3\u05d9\u05e0\u05d4: \u05d0\u05d9\u05df \u05dc\u05d9 \u05d3\u05ea (7)",
      "15": "\u05d1\u05d0\u05d9\u05d6\u05d5 \u05de\u05d3\u05d9\u05e0\u05d4 \u05de\u05ea\u05d7\u05ea\u05e0\u05d9\u05dd \u05d1\u05e1\u05de\u05e1\u05d8\u05e8 \u05d2' \u05d0\u05d5 \u05d3'? (3, 5)",
      "16": "\u05d4\u05e8\u05d5\u05e4\u05d0 \u05d4\u05d9\u05d3\u05d5\u05e2 \u05e2\u05d5\u05dc\u05d4, \u05d0\u05d9\u05d6\u05d5 \u05e8\u05de\u05d4! \u05d0\u05d9\u05d6\u05d4 \u05d9\u05d5\u05e4\u05d9! (4, 4) (\u05de)",
      "17": "\u05de\u05e1\u05e4\u05d9\u05e7 \u05e9\u05d4\u05df \u05de\u05e6\u05d7\u05d9\u05e7\u05d5\u05ea \u05de\u05e7\u05e8\u05d5\u05d1 (7)",
      "19": "\u05d1\u05db\u05dc \u05e4\u05e2\u05dd \u05e9\u05d4\u05e9\u05d9\u05d9\u05d8\u05ea \u05d4\u05d9\u05d0 \u05de\u05e9\u05e4\u05d7\u05d4 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05ea (5)",
      "20": "\u05d1\u05d0\u05d9\u05e0\u05d3\u05d5\u05e0\u05d6\u05d9\u05d4 \u05d5\u05de\u05dc\u05d6\u05d9\u05d4 \u05d6\u05d4 \u05e2\u05dc\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05de\u05d7\u05dc\u05d5\u05ea (5) (\u05de)",
      "22": "\u05d1\u05de\u05d8\u05d1\u05d7 \u05d0\u05e4\u05e9\u05e8 \u05dc\u05de\u05e6\u05d5\u05d0 \u05e9\u05d5\u05d8\u05e8 \u05d9\u05e9\u05df (4)",
      "24": "\u05de\u05d9 \u05e9\u05e7\u05dd \u05e2\u05dc\u05d9 \u05d2\u05dd \u05d9\u05db\u05d5\u05dc \u05dc\u05e8\u05e4\u05d0 \u05d0\u05d5\u05ea\u05d9 (3)"
    },
    "across": {
      "1": "\u05d4\u05e8\u05d9\u05dd \u05e9\u05de\u05d9\u05e8, \u05d5\u05d4\u05dd \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05e7\u05d1\u05dc \u05e9\u05d1\u05ea (6, 5)",
      "8": "\u05e8\u05d0\u05d4/\u05d9 14 \u05de\u05d0\u05d5\u05d6\u05df",
      "9": "\u05dc\u05d0 \u05e2\u05d5\u05e9\u05d4 \u05db\u05dc\u05d5\u05dd \u05e2\u05dd \u05d4\u05e9\u05d8\u05d7\u05d9\u05dd \u05d1\u05e4\u05e0\u05e1\u05d9\u05d4, \u05dc\u05de\u05e9\u05dc (4, 5)",
      "10": "\u05ea\u05e7\u05d9\u05e2\u05ea \u05db\u05e3 \u05d1\u05de\u05d4 \u05e9\u05d4\u05de\u05e6\u05d9\u05d0 16 \u05de\u05d0\u05d5\u05e0\u05da \u05dc\u05e2\u05ea\u05d9\u05d3 \u05d8\u05d5\u05d1 (6) (\u05de)",
      "12": "\u05e7\u05e8\u05d5\u05e0\u05d9\u05ea \u05d5\u05e7\u05e8\u05d5\u05df \u05dc\u05dc\u05d0 \u05d7\u05d9\u05d1\u05d5\u05e8 \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd (5) (\u05de)",
      "14": "\u05e2\u05dd 8 \u05de\u05d0\u05d5\u05d6\u05df. \u05d0\u05e4\u05d9\u05dc\u05d5 \u05d4\u05d5\u05d0 \u05e6\u05dd \u05d5\u05d6\u05d4 \u05e0\u05de\u05d0\u05e1 \u05e2\u05dc\u05d9\u05d5 (4, 2, 4)",
      "15": "\u05de\u05d2\u05dc\u05d9\u05dd \u05e9\u05d9\u05e9 \u05d1\u05ea\u05d5\u05da \u05d7\u05d9\u05d9\u05dd \u05db\u05d4\u05df \u05e9\u05d7\u05e7\u05e0\u05d9\u05ea (7)",
      "17": "\u05db\u05ea\u05d1\u05d4 \u05e2\u05dc \u05d4\u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea \u05d5\u05d0\u05d5\u05dc\u05d9 \u05e2\u05dc \u05de\u05d4 \u05e9\u05d4\u05ea\u05e0\u05d2\u05d3\u05d4 \u05dc\u05d5 (4, 3)",
      "18": "\u05d4\u05d8\u05e8\u05d3\u05df \u05d5\u05d3\u05e0\u05d9 \u05e7\u05d5\u05e9\u05de\u05e8\u05d5 (6)",
      "19": "\u05d0\u05d9\u05e0\u05d5 \u05e9\u05d5\u05db\u05d7 \u05d0\u05ea \u05d0\u05dc\u05d4 \u05de\u05e9\u05de\u05d0\u05dc, \u05ea\u05d4\u05d9\u05d4 \u05ea\u05d6\u05d5\u05d6\u05d4 \u05dc\u05d0\u05de\u05e6\u05e2 (5)",
      "21": "\u05d1\u05de\u05e4\u05dc\u05d2\u05d4 \u05d3\u05ea\u05d9\u05ea \u05d4\u05ea\u05e2\u05e8\u05d1\u05d1\u05d5 \u05e4\u05e8\u05d9\u05dd \u05dc\u05d0 \u05db\u05e9\u05e8\u05d9\u05dd \u05d1\u05db\u05dc\u05dc (6)",
      "23": "\u05d4\u05d5\u05d0 \u05e1\u05d5\u05d2 \u05e9\u05dc \u05de\u05d3\u05d1\u05e8 \u05d0\u05dc\u05d9 \u05dc\u05e4\u05e0\u05d9 \u05d6\u05d4, \u05db\u05d9 \u05db\u05dc \u05d4\u05e9\u05d0\u05e8 \u05e0\u05e4\u05e1\u05dc\u05d5 (9)",
