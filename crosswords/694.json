  "definitions": {
    "down": {
      "1": "\u05e9\u05d9\u05d1\u05d5\u05e9 \u05e9\u05dc \u05d7\u05d6\u05e8\u05ea \u05d4\u05de\u05e9\u05d8\u05e8\u05d4 (5) (\u05de)",
      "2": "\u05e7\u05e8\u05d1 \u05d9\u05e6\u05e8 \u05d9\u05d3 (3)",
      "3": "\u05dc\u05d0 \u05db\u05d5\u05dc\u05dd \u05e0\u05e9\u05d0\u05e8\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9 \u05d1\u05d9\u05e8\u05d4 (5)",
      "4": "\u05e8\u05e9\u05e2 \u05d7\u05d6\u05e8 \u05d5\u05d4\u05dd \u05e0\u05ea\u05e0\u05d5 \u05e4\u05e8\u05d9 \u05d1\u05d0\u05d5\u05e4\u05df \u05d6\u05de\u05e0\u05d9 (2, 5) (\u05de)",
      "5": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05d0\u05d5\u05d4\u05d1\u05d9\u05dd \u05e9\u05d5\u05d1, \u05dc\u05e4\u05d9\u05d5 \u05d4\u05d9\u05d4 \u05db\u05ea\u05d5\u05d1 \u05db\u05d0\u05df \u05e4\u05dc\u05da (4, 4)",
      "6": "\u05d3\u05e8\u05d2\u05d4 \u05e9\u05dc \u05de\u05e1 \u05e8\u05d1\u05d9\u05e2\u05d9 (4)",
      "7": "\u05d0\u05dc \u05ea\u05e1\u05d8\u05d9 \u05de\u05d0\u05d5\u05d9\u05d1 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9, \u05d6\u05d4 \u05d8\u05e7\u05e1 \u05de\u05db\u05d5\u05d1\u05d3 (4, 4)",
      "11": "\u05d4\u05d5\u05d0 \u05d9\u05e9\u05de\u05d9\u05e2 \u05e8\u05e2\u05e9, \u05d1\u05e8\u05d5\u05e8 \u05db\u05d9 \u05d4\u05d9\u05d0 \u05d4\u05d9\u05ea\u05d4 \u05d4\u05d9\u05e4\u05d4 \u05d1\u05e2\u05d5\u05dc\u05dd (4, 3)",
      "13": "\u05de\u05e0\u05d4\u05dc \u05de\u05e8\u05d6\u05d4 \u05d5\u05e9\u05d7\u05e7\u05df (4, 3)",
      "15": "\u05d0\u05d7\u05dc\u05d9\u05e3 \u05d7\u05d6\u05d4 \u05e7\u05d8\u05df \u05d5\u05d6\u05de\u05e8 (4, 4)",
      "16": "\u05e9\u05d5\u05e7 \u05e9\u05dc\u05dd \u05dc\u05e4\u05e0\u05d9 \u05dc\u05d9\u05d3\u05d4 (5, 3)",
      "17": "\u05d0\u05e1\u05de\u05d9\u05dd \u05d1\u05de\u05e7\u05d5\u05dd \u05d7\u05ea\u05dc\u05ea\u05d5\u05dc\u05d5\u05ea \u05dc\u05de\u05e9\u05dc (7)",
      "19": "\u05d9\u05e4\u05d4, \u05ea\u05e9\u05e4\u05d9\u05e2\u05d9 \u05e2\u05dc \u05d4\u05de\u05e0\u05e6\u05d7 (5)",
      "20": "\u05e1\u05d9\u05de\u05e0\u05d9\u05dd? \u05d0\u05d5\u05dc\u05d9 \u05e4\u05e8\u05d9? (5)",
      "22": "\u05dc\u05d0 \u05d9\u05d5\u05ea\u05e8 \u05de\u05dc\u05d7\u05dd \u05e4\u05e8\u05d7 (4)",
      "24": "\u05d4\u05d9\u05d4 8 \u05de\u05d0\u05d5\u05d6\u05df \u05d1\u05e8\u05d2\u05dc (3)"
    },
    "across": {
      "1": "\u05d1\u05d0\u05d9\u05d6\u05d5 \u05de\u05e4\u05d4 \u05d9\u05e9 \u05db\u05e8\u05d8\u05d9\u05e1 \u05d5\u05dc\u05d0 \u05e0\u05e2\u05de\u05d5\u05d3 \u05dc\u05e4\u05e0\u05d9 \u05de\u05e4\u05ea\u05d7\u05d5\u05ea (5, 6) (\u05de)",
      "8": "\u05d1\u05e8\u05e9\u05ea\u05d5\u05ea \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05d0\u05d5\u05dc\u05d9 \u05d9\u05e9 \u05d1\u05d5 \u05de\u05d9\u05dd? (4)",
      "9": "\u05dc\u05b0\u05d4\u05b4\u05ea\u05b7\u05dc\u05bc\u05b5\u05dd (6, 3)",
      "10": "\u05d0\u05de\u05d5\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e1\u05d5\u05e3 \u05de\u05d4 \u05e9\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05ea\u05d7\u05ea\u05d9\u05ea \u05d4\u05d3\u05e3 (6)",
      "12": "\u05d0\u05d9\u05d6\u05d5 \u05d4\u05d1\u05e8\u05e7\u05d4, \u05d1\u05d1\u05e7\u05e9\u05d4 \u05d0\u05dc \u05ea\u05de\u05e9\u05d9\u05db\u05d9 \u05d1\u05d3\u05e8\u05da \u05d6\u05d5 (5) (\u05e9)",
      "14": "\u05d9\u05e9\u05e8\u05d0\u05dc \u05e0\u05e9\u05d5\u05d9, \u05d2\u05e8\u05d5\u05e9 \u05d0\u05d5 \u05e8\u05d5\u05d5\u05e7 (2, 4)",
      "15": "\u05d0\u05d9\u05e4\u05d4 \u05d4\u05e9\u05d9\u05e8\u05d9\u05dd \u05e9\u05dc\u05d4? \u05d1\u05e2\u05e6\u05dd \u05d4\u05db\u05d5\u05d5\u05e0\u05d4 \u05d4\u05e4\u05d5\u05db\u05d4 (7)",
      "17": "\u05d9\u05d7\u05d9\u05d3\u05d4 \u05e9\u05dc \u05d4\u05e8\u05e2\u05dc\u05d4 \u05d5\u05dc\u05d0 \u05d9\u05d5\u05ea\u05e8 (7)",
      "18": "\u05e7\u05d5\u05e8\u05d4 \u05d5\u05d9\u05e9\u05e0\u05d5 \u05d0\u05d1\u05dc \u05d4\u05dd \u05dc\u05d0 \u05dc\u05d2\u05de\u05e8\u05d9 (6)",
      "19": "\u05e0\u05d4\u05e4\u05d5\u05da \u05d4\u05d5\u05d0! \u05de\u05db\u05e8\u05d9\u05d6\u05d9\u05dd \u05d1\u05e1\u05d5\u05e3 \u05d7\u05d5\u05d3\u05e9 \u05e9\u05d1\u05d8 (5)",
      "21": "\u05e8\u05d5\u05d3\u05d5\u05ea \u05d5\u05d9\u05d5\u05d3\u05e2\u05d5\u05ea \u05e9\u05e4\u05d4 (6)",
      "23": "\u05d7\u05d5\u05d1\u05e9 \u05e8\u05e1\u05e7 \u05d5\u05e1\u05dc\u05e3 \u05d0\u05ea \u05d4\u05dc\u05d5\"\u05d6 (5, 4)",
      "25": "\u05e7\u05d5\u05d5 \u05dc\u05e4\u05d2\u05d5\u05e9 \u05d0\u05ea \u05d5\u05d9\u05e8\u05d2'\u05d9\u05e0\u05d9\u05d4 (4)",
      "26": "\u05ea\u05d7\u05e9\u05d1\u05d9, \u05ea\u05d4\u05d9\u05d5 \u05d5\u05de\u05d1\u05e0\u05d4, \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d9\u05d7\u05e1\u05d9 \u05e6\u05d9\u05d1\u05d5\u05e8 \u05d8\u05d5\u05d1\u05d9\u05dd (5, 6)"
    }
  }
}