  "definitions": {
    "down": {
      "1": "\u05de\u05d0\u05d7\u05d5\u05e8 \u05d1\u05e4\u05e0\u05d9\u05dd \u05d1\u05d0\u05de\u05e6\u05e2 \u05d4\u05e9\u05e2\u05d5\u05df (3, 2)",
      "2": "\u05e8\u05d0\u05e9 \u05e2\u05d9\u05e8, \u05e2\u05d9\u05e8, \u05e1\u05d5\u05e3 \u05e2\u05d9\u05e8 (3)",
      "3": "\u05d0\u05ea \u05de\u05d9 \u05ea\u05d4\u05e8\u05d5\u05e1 \u05d1\u05d1\u05d9\u05ea \u05d4\u05db\u05dc\u05d0? (5)",
      "4": "\u05e9\u05e8 \u05d5\u05d0\u05d1\u05d9\u05e8 \u05e8\u05d1 \u05e4\u05d4 (7)",
      "5": "\u05de\u05e0\u05d9\u05df \u05e9\u05d5\u05d3\u05d3\u05d9\u05dd \u05e9\u05e2\u05d5\u05d1\u05d3\u05d9\u05dd \u05dc\u05d1\u05d3? (8)",
      "6": "\u05db\u05df, \u05db\u05df, \u05d1\u05d7\u05d5\u05e5 \u05d7\u05d5\u05d6\u05e8 \u05d4\u05d1\u05df \u05e9\u05dc 25 \u05de\u05d0\u05d5\u05d6\u05df (4)",
      "7": "\u05e1\u05d5\u05d2 \u05e9\u05dc \u05d1\u05e2\u05dc \u05d7\u05d9\u05d9\u05dd \u05d0\u05db\u05dc \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05e9\u05d4\u05d5\u05d0 \u05e1\u05de\u05dc \u05d1\u05e8\u05d9\u05d8\u05d9 (6, 2)",
      "11": "\u05e8\u05d1 \u05de\u05e9\u05e0\u05d4 \u05e2\u05dd \u05e0\u05d8\u05d9\u05d5\u05ea \u05d9\u05de\u05e0\u05d9\u05d5\u05ea (7)",
      "13": "\u05e1\u05d5\u05d2 \u05d1? \u05d0\u05e0\u05d2\u05dc\u05d9\u05dd? \u05d4\u05d5\u05dc\u05db\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05e4\u05d4 \u05e4\u05d9\u05e6\u05d5\u05e6\u05d9\u05dd (7) (\u05de)",
      "15": "\u05de\u05d7\u05d6\u05d0\u05d9 \u05e2\u05dd \u05e7\u05e1\u05dd \u05dc\u05d0 \u05d8\u05d5\u05d1 (5, 3)",
      "16": "\u05d4\u05d5\u05d0 \u05d0\u05ea\u05d7\u05dc \u05de\u05dc\u05de\u05e2\u05dc\u05d4, \u05d4\u05dd \u05d4\u05d5\u05e8\u05d5 \u05de\u05dc\u05de\u05d8\u05d4, \u05d5\u05d4\u05d9\u05d0 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05d4 (8) (\u05de)",
      "17": "\u05d1\u05d1\u05e8\u05d9\u05d8\u05e0\u05d9\u05d4 \u05d4\u05d5\u05d0 \u05de\u05d7\u05e1\u05dc \u05d0\u05d5\u05ea\u05df \u05d1\u05de\u05db\u05e9\u05d9\u05e8 \u05e2\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd (7)",
      "19": "\u05e7\u05d9\u05e6\u05d5\u05e5 \u05e9\u05dc \u05de\u05d8\u05d1\u05e2 \u05d1\u05de\u05d9\u05d3\u05d4 \u05de\u05e1\u05d5\u05d9\u05d9\u05de\u05ea (5) (\u05de)",
      "20": "\u05e0\u05d9\u05e6\u05d7\u05d5\u05df \u05d4\u05e0\u05e1\u05d9\u05db\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d1\u05d9\u05e8\u05d4 (5) (\u05de)",
      "22": "\u05e9\u05dc\u05d7\u05d5 \u05d0\u05d5\u05ea\u05d5 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05d4, \u05de\u05d5\u05ea\u05e7 (4)",
      "24": "\u05d3\u05d5\u05d3\u05d4 \u05d0\u05e0\u05d2\u05dc\u05d9\u05d4 \u05e2\u05d5\u05dc\u05d4 \u05de\u05e0\u05e6\u05e8\u05d9\u05dd \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc (3)"
    },
    "across": {
      "1": "\u05d4\u05d3\u05d2 \u05e9\u05d5\u05d1 \u05d1\u05e8\u05d7 \u05d5\u05e0\u05d5\u05ea\u05df \u05d1\u05d9\u05e1 \u05dc\u05e8\u05d0\u05e9 \u05d4\u05de\u05de\u05e9\u05dc\u05d4 (5, 6)",
      "8": "\u05d4\u05d5\u05d0 \u05d8\u05e1, \u05d5\u05d4\u05d5\u05d0 \u05d1\u05dc\u05d5\u05e0\u05d3\u05d5\u05df \u05d0\u05d5 \u05d1\u05e0\u05d9\u05d5 \u05d9\u05d5\u05e8\u05e7 (4)",
      "9": "\u05e8\u05d4\"\u05de \u05de\u05d0\u05d7\u05d5\u05e8, \u05d1\u05e7\u05d9\u05e6\u05d5\u05e8 \u05d0\u05d9\u05ea\u05df \u05de\u05ea (4, 5)",
      "10": "\u05d2\u05e8\u05e0\u05d8 \u05d7\u05d5\u05e7\u05d9 \u05d9\u05e0\u05e6\u05d7 \u05d0\u05d5\u05ea\u05d9 (4, 2)",
      "12": "\u05d7\u05e0\u05d5\u05ea \u05e9\u05db\u05e0\u05e8\u05d0\u05d4 \u05dc\u05d0 \u05e0\u05d5\u05e9\u05db\u05ea (5)",
      "14": "\u05e0\u05d9\u05e6\u05d7\u05d5\u05df \u05d0\u05e0\u05d2\u05dc\u05d9 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05d4 \u05d6\u05d4 \u05db\u05de\u05d5 \u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d9\u05dc\u05d5 (6) (\u05de)",
      "15": "\u05d0\u05d9\u05df \u05e9\u05d5\u05dd \u05e2\u05d5\u05d2\u05d4, \u05d2\u05dd \u05d1\u05d4\u05d9\u05d9\u05d8\u05e7 (7) (\u05de)",
      "17": "\u05d0\u05e0\u05d2\u05dc\u05d9 \u05e7\u05d8\u05df \u05e2\u05dc\u05d4 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d1\u05e8\u05d5\u05e1\u05d9\u05d4 (7)",
      "18": "\u05e0\u05e9\u05e8\u05e3 \u05e9\u05e7 \u05e9\u05e0\u05d4 \u05e9\u05dc\u05d5 \u05d1\u05de\u05d7\u05d5\u05d6 \u05d0\u05e0\u05d2\u05dc\u05d9 (6)",
      "19": "\u05dc\u05d0 \u05de\u05ea\u05e7\u05e9\u05d4 \u05dc\u05d4\u05d6\u05d9\u05d6 \u05d6\u05d9\u05ea (5)",
