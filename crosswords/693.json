      "23": "\u05e1\u05d8\u05e8\u05d9\u05d8 \u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05df \u05e0\u05d9\u05e6\u05d7 \u05d1 14 \u05de\u05d0\u05d5\u05d6\u05df (9) (\u05de)",
      "25": "\u05de\u05dc\u05da \u05d0\u05e0\u05d2\u05dc\u05d9 \u05e9\u05e9\u05dd \u05db\u05e1\u05e3 \u05d1\u05de\u05d9\u05d3\u05d4 (4)",
