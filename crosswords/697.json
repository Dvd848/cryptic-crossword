      "11": "\u05d4\u05e7\u05d5\u05dc\u05d8\u05d9\u05dd \u05d1\u05e4\u05d9 \u05d4\u05d0\u05d3\u05de\u05d9\u05e8\u05dc \u05d4\u05d8\u05d5\u05e8\u05e7\u05d9 (4, 3)",
